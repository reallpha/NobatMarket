  /// موجودی بعد از تراکنش
  balanceAfter BigInt

  /// توضیحات
  description String

  /// شناسه مرجع (رزرو، پرداخت و...)
  referenceId String?

  /// نوع مرجع
  referenceType String?

  /// وضعیت تراکنش
  isCompleted Boolean @default(false)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با کیف پول
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// پرداخت مرتبط
  payment Payment?

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
  @@map("transactions")
