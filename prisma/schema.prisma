/// پرداخت
model Payment {
  /// شناسه یکتای پرداخت
  id String @id @default(cuid())

  /// شماره پرداخت
  paymentNumber String @unique

  /// شناسه رزرو مرتبط
  bookingId String

  /// شناسه کیف پول هنرمند (در صورت پرداخت به کیف پول)
  walletId String?

  /// مبلغ (تومان)
  amount BigInt

  /// کارمزد پلتفرم (تومان)
  platformFee BigInt @default(0)

  /// کارمزد استودیو (تومان)
  studioFee BigInt @default(0)

  /// مبلغ خالص هنرمند (تومان)
  artistNetAmount BigInt @default(0)

  /// روش پرداخت
  method PaymentMethod

  /// وضعیت پرداخت
  status PaymentStatus @default(PENDING)

  /// نوع پرداخت: DEPOSIT (بیعانه ۲۰٪ = کارمزد پلتفرم) یا REMAINDER (باقی‌مانده = سهم هنرمند)
  purpose String @default("DEPOSIT")

  /// شناسه تراکنش درگاه پرداخت
  gatewayTransactionId String?

  /// شناسه ارجاع درگاه پرداخت
  gatewayRefId String?

  /// پاسخ خام درگاه پرداخت
  gatewayResponse Json?

  /// کد رهگیری
  trackingCode String?

  /// یادداشت
  note String?

  /// تاریخ پرداخت
  paidAt DateTime?

  /// تاریخ بازپرداخت
  refundedAt DateTime?

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با رزرو
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)  /// رابطه با کیف پول
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  /// شناسه تراکنش مرتبط
  transactionId String? @unique

  /// تراکنش مرتبط
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)




  @@index([bookingId])
  @@index([walletId])
  @@index([status])
  @@index([method])
  @@index([gatewayTransactionId])
  @@index([createdAt])
  @@map("payments")
}

/// نظر مشتری
model Review {
  /// شناسه یکتای نظر
  id String @id @default(cuid())

  /// شناسه نویسنده نظر
  authorId String

  /// شناسه دریافت‌کننده نظر
  recipientId String

  /// شناسه رزرو مرتبط
  bookingId String?

  /// شناسه آیتم پورتفولیو (نظر روی کار)
  portfolioItemId String?

  /// رتبه‌بندی کلی (۱ تا ۵)
  rating Int

  /// امتیاز ۰ تا ۱۰۰ (معیار اصلی پروفایل هنرمند)
  score Int?

  /// رتبه‌بندی خلاقیت
  creativityRating Int?

  /// رتبه‌بندی حرفه‌ای بودن
  professionalismRating Int?

  /// رتبه‌بندی تمیزی کار
  cleanlinessRating Int?

  /// رتبه‌بندی ارتباط
  communicationRating Int?

  /// متن نظر
  comment String

  /// پاسخ هنرمند به نظر
  artistReply String?

  /// تاریخ پاسخ هنرمند
  artistReplyAt DateTime?

  /// آیا نظر تأیید شده
  isVerified Boolean @default(false)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با نویسنده
  author User @relation("GivenReviews", fields: [authorId], references: [id], onDelete: Cascade)

  /// رابطه با دریافت‌کننده
  recipient User @relation("ReceivedReviews", fields: [recipientId], references: [id], onDelete: Cascade)

  /// رابطه با رزرو
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// رابطه با آیتم پورتفولیو
  portfolioItem PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([recipientId])
  @@index([bookingId])
  @@index([portfolioItemId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

/// کیف پول هنرمند
model Wallet {
  /// شناسه یکتای کیف پول
  id String @id @default(cuid())

  /// شناسه مالک
  ownerId String @unique

  /// موجودی کل (تومان)
  balance BigInt @default(0)

  /// موجودی قابل برداشت (تومان)
  withdrawableBalance BigInt @default(0)

  /// موجودی در انتظار تسویه (تومان)
  pendingBalance BigInt @default(0)

  /// مسدود شده (تومان) - برای پرداخت‌های ناموفق
  frozenBalance BigInt @default(0)

  /// کل واریزی‌ها
  totalDeposited BigInt @default(0)

  /// کل برداشت‌ها
  totalWithdrawn BigInt @default(0)

  /// شماره کارت بانکی (آخرین ۴ رقم)
  lastFourCardNumber String?

  /// شماره شبا
  iban String?

  /// نام صاحب حساب
  accountHolderName String?

  /// بانک
  bankName String?

  /// آیا کیف پول فعال است
  isActive Boolean @default(true)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با مالک
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// تراکنش‌ها
  transactions Transaction[]

  /// پرداخت‌ها
  payments Payment[]

  /// درخواست‌های برداشت
  withdrawalRequests WithdrawalRequest[]

  @@index([ownerId])
  @@map("wallets")
}

/// تراکنش کیف پول
model Transaction {
  /// شناسه یکتای تراکنش
  id String @id @default(cuid())

  /// شناسه کیف پول
  walletId String

  /// شناسه کاربر مرتبط
  userId String

  /// نوع تراکنش
  type TransactionType

  /// مبلغ (تومان)
  amount BigInt

  /// موجودی قبل از تراکنش
