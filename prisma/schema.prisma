/// مکالمه / چت
model Conversation {
  /// شناسه یکتای مکالمه
  id String @id @default(cuid())

  /// عنوان مکالمه
  title String?

  /// شناسه رزرو مرتبط
  bookingId String? @unique

  /// شناسه درخواست سفارشی مرتبط
  requestId String? @unique

  /// آیا مکالمه فعال است
  isActive Boolean @default(true)

  /// آخرین پیام
  lastMessageAt DateTime?

  /// متن آخرین پیام
  lastMessagePreview String?

  /// تعداد پیام‌های خوانده نشده
  unreadCount Int @default(0)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// شرکت‌کنندگان
  participants ConversationParticipant[]

  /// پیام‌ها
  messages Message[]

  @@index([lastMessageAt])
  @@index([isActive])
  @@index([bookingId])
  @@index([requestId])
  @@map("conversations")
}

/// شرکت‌کننده مکالمه
model ConversationParticipant {
  /// شناسه یکتای رکورد
  id String @id @default(cuid())

  /// شناسه مکالمه
  conversationId String

  /// شناسه کاربر
  userId String

  /// تعداد پیام‌های خوانده نشده
  unreadCount Int @default(0)

  /// آخرین پیام خوانده شده
  lastReadAt DateTime?

  /// آیا کاربر مکالمه را بی‌صدا کرده
  isMuted Boolean @default(false)

  /// آیا کاربر مکالمه را آرشیو کرده
  isArchived Boolean @default(false)

  /// تاریخ پیوستن
  joinedAt DateTime @default(now())

  /// رابطه با مکالمه
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// پیام چت
model Message {
  /// شناسه یکتای پیام
  id String @id @default(cuid())

  /// شناسه مکالمه
  conversationId String

  /// شناسه فرستنده
  senderId String

  /// متن پیام
  content String

  /// لیست فایل‌های پیوست (تصاویر، ویدئو)
  attachments String[]

  /// نوع پیام (متن، تصویر، فایل، سیستمی)
  messageType String @default("text")

  /// وضعیت پیام
  status MessageStatus @default(SENT)

  /// آیا پیام حذف شده
  isDeleted Boolean @default(false)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با مکالمه
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// رابطه با فرستنده
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

/// پشتیبانی از جستجوی فول‌تکست
model SearchIndex {
  /// شناسه یکتای
  id String @id @default(cuid())

  /// نوع موجودیت
  entityType String

  /// شناسه موجودیت
  entityId String

  /// متن قابل جستجو
  searchText String

  /// فیلترهای جستجو (JSON)
  filters Json?

  /// شاخص رتبه‌بندی
  rank Float @default(0)

  /// تاریخ به‌روزرسانی
  updatedAt DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([rank])
  @@map("search_index")
}

// ============================================================================
// مدل‌های جدید Stage 7
// ============================================================================

/// اعلان درون‌برنامه‌ای
model Notification {
  /// شناسه یکتای اعلان
  id String @id @default(cuid())

  /// شناسه کاربر دریافت‌کننده
  userId String

  /// عنوان اعلان
  title String

  /// متن اعلان
  message String

  /// نوع اعلان
  type NotificationType @default(INFO)

  /// آیا خوانده شده
  isRead Boolean @default(false)

  /// لینک اختیاری (برای ناوبری)
  link String?

  /// داده‌های اضافی (JSON)
  data Json?

  /// فایل پیوست (URL)
  fileUrl String?
  fileName String?

  /// آیا قابل پاسخ است (تیکت)
  isTicket Boolean @default(false)

  /// شناسه فرستنده (برای پیام‌های ادمین)
  senderId String?

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// رابطه با فرستنده
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  /// پاسخ‌ها
  replies NotificationReply[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// پاسخ‌های تیکت اعلان
model NotificationReply {
  /// شناسه یکتای پاسخ
  id String @id @default(cuid())

  /// شناسه اعلان مربوطه
  notificationId String

  /// شناسه فرستنده پاسخ
  senderId String

  /// متن پاسخ
  message String

  /// فایل پیوست (URL)
  fileUrl String?
  fileName String?

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با اعلان
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  /// رابطه با فرستنده
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("notification_replies")
}

/// انوع اعلان
enum NotificationType {
  INFO
  SUCCESS
  WARNING
  BOOKING
  PAYMENT
  MESSAGE
}

/// صفحه CMS
model CmsPage {
  /// شناسه یکتای صفحه
  id String @id @default(cuid())

  /// شناسه URL (یکتا)
  slug String @unique

  /// عنوان صفحه
  title String

  /// محتوا (Markdown)
  content String

  /// عنوان SEO
  seoTitle String?

  /// توضیحات SEO
  seoDescription String?

  /// HTML سفارشی (برای ویژوال بلدر آینده)
  customHtml String?

  /// CSS سفارشی
  customCss String?

  /// JS سفارشی
  customJs String?

  /// آیا صفحه فعال است
  isActive Boolean @default(true)

  /// نمایش هدر پیش‌فرض سایت در این صفحه
  showHeader Boolean @default(true)

  /// نمایش فوتر پیش‌فرض سایت در این صفحه
  showFooter Boolean @default(true)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("cms_pages")
}

/// لیست انتظار هنرمند
model Waitlist {
  /// شناسه یکتای
  id String @id @default(cuid())

  /// شناسه کاربر
  userId String

  /// شناسه هنرمند
  artistProfileId String

  /// سبک مورد نظر
  preferredStyle TattooStyle?

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// رابطه با هنرمند
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, artistProfileId])
  @@index([userId])
  @@index([artistProfileId])
  @@map("waitlist")
}

// ============================================================================
// مدل‌های جدید - مرحله نهایی
// ============================================================================

/// مقالات مجله
model BlogPost {
  /// شناسه یکتای
  id String @id @default(cuid())

  /// شناسه URL (یکتا)
  slug String @unique

  /// عنوان مقاله
  title String

  /// خلاصه
  excerpt String

  /// محتوا (Markdown)
  content String

  /// تصویر کاور
  coverImage String?

  /// شناسه نویسنده (ادمین)
  authorId String

  /// دسته‌بندی
  category BlogCategory @default(NEWS)

  /// آیا منتشر شده
  isPublished Boolean @default(false)

  /// مقاله ویژه (هایلایت قرمز در مجله)
  isFeatured Boolean @default(false)

  /// اطلاعیه (هایلایت زرد در مجله)
  isNotice Boolean @default(false)

  /// تعداد بازدید
  views Int @default(0)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با نویسنده
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([isPublished])
  @@index([category])
  @@index([createdAt])
  @@map("blog_posts")
}

/// دسته‌بندی مقالات
enum BlogCategory {
  AFTER_CARE
  STYLES
  NEWS
  ANNOUNCEMENT
  GUIDES
}

/// یادداشت هنرمند درباره مشتری
model ClientNote {
  /// شناسه یکتای
  id String @id @default(cuid())

  /// شناسه هنرمند
  artistId String

  /// شناسه مشتری
  clientId String

  /// متن یادداشت
  note String

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با هنرمند
  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  /// رابطه با مشتری
  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([clientId])
  @@map("client_notes")
}

/// تنظیمات سیستم
model SystemSetting {
  /// شناسه یکتای
  id String @id @default(cuid())

  /// کلید تنظیم
  key String @unique

  /// مقدار
  value String

  /// توضیحات
  description String?

  /// تاریخ به‌روزرسانی
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("system_settings")
}

/// گزارش عملیات ادمین
model AuditLog {
  /// شناسه یکتای
  id String @id @default(cuid())

  /// شناسه ادمین
  adminId String

  /// نوع عملیات
  action String

  /// جزئیات (JSON)
  details Json?

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با ادمین
  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([read])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([isActive])
  @@map("newsletter_subscribers")
}

// ============================================================================
// کامنت‌های مطالب مجله
// ============================================================================
model BlogComment {
  id String @id @default(cuid())

  /// شناسه مقاله
  postSlug String

  /// شناسه کاربر نویسنده کامنت
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// متن کامنت
  content String

  /// آیا تأیید شده توسط ادمین
  isApproved Boolean @default(false)

  /// لایک‌ها
  likeCount Int @default(0)

  /// دیس‌لایک‌ها
  dislikeCount Int @default(0)

  /// کامنت والد (برای ریپلای)
  parentId String?
  parent BlogComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("CommentReplies")
  reactions CommentReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postSlug])
  @@index([userId])
  @@index([isApproved])
  @@map("blog_comments")
}

// ============================================================================
// واکنش‌های کامنت (لایک/دیس‌لایک)
// ============================================================================
model CommentReaction {
  id String @id @default(cuid())
  commentId String
  comment BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String // "LIKE" or "DISLIKE"
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_reactions")
}
