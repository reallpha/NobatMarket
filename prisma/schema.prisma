// ============================================================================
// پروژه: نوبت مارکت (NOBAT_MARKET)
// توضیح: اسکیمای پایگاه داده اصلی پلتفرم بازار و رزرو تتو
// نسخه: 1.0.0
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// انوم‌ها (Enumerations)
// ============================================================================

/// نقش‌های کاربران در سیستم
enum UserRole {
  /// کاربر عادی (مشتری)
  CLIENT
  /// هنرمند تتو
  ARTIST
  /// مدیر سیستم
  ADMIN
}

/// وضعیت حساب کاربری
enum UserStatus {
  /// فعال
  ACTIVE
  /// غیرفعال
  INACTIVE
  /// معلق (مسدود شده توسط ادمین)
  SUSPENDED
  /// در انتظار تأیید
  PENDING_VERIFICATION
}

/// جنسیت
enum Gender {
  /// مرد
  MALE
  /// زن
  FEMALE
  /// ترجیح می‌دهم نگویم
  OTHER
}

/// سبک‌های تتو
enum TattooStyle {
  /// بلک‌ورک (سیاه‌کاری)
  BLACKWORK
  /// رئالیسم (واقع‌گرایانه)
  REALISM
  /// ژئومتریک (هندسی)
  GEOMETRIC
  /// مینیمال (ساده و ظریف)
  MINIMAL
  /// آبستره (انتزاعی)
  ABSTRACT
  /// اולד اسکول (سنتی غربی)
  OLD_SCHOOL
  /// نئو- trad
  NEO_TRADITIONAL
  /// آبی و خاکستری
  BLACK_AND_GREY
  /// رنگی
  COLOR
  /// لاین آرت (خطی)
  LINE_ART
  /// فاین لاین
  FINE_LINE
  /// دات‌ورک (نقطه‌ای)
  DOTWORK
  /// ژاپنی (ایرزوکا)
  JAPANESE
  /// مائوری
  TRIBAL
  /// واتروکالر (آبی رنگ)
  WATERCOLOR
  /// لترینگ (خوشنویسی فارسی/عربی)
  LETTERING
  /// بیو mech (مکانیکی زیستی)
  BIOMECHANICAL
  /// چیکان‌스타일 (ژاپنی معاصر)
  CHICANO
  /// سایر
  OTHER
}

/// وضعیت پورتفولیو آیتم
enum PortfolioStatus {
  /// منتشر شده
  PUBLISHED
  /// پیش‌نویس
  DRAFT
  /// بایگانی شده
  ARCHIVED
}

/// وضعیت رزرو
enum BookingStatus {
  /// درخواست شده (در انتظار تأیید ادمین)
  REQUESTED
  /// در انتظار تأیید هنرمند (ادمین تأیید کرده)
  PENDING_ARTIST
  /// تأیید شده
  CONFIRMED
  /// در حال انجام
  IN_PROGRESS
  /// تکمیل شده
  COMPLETED
  /// لغو شده توسط مشتری
  CANCELLED_BY_CLIENT
  /// لغو شده توسط هنرمند
  CANCELLED_BY_ARTIST
  /// عدم حضور مشتری
  NO_SHOW
  /// به‌روزرسانی نیاز دارد (تغییر زمان)
  RESCHEDULE_PENDING
}

/// وضعیت پرداخت
enum PaymentStatus {
  /// در انتظار پرداخت
  PENDING
  /// پرداخت شده
  PAID
  /// بازپرداخت شده (کامل)
  REFUNDED
  /// بازپرداخت جزئی
  PARTIALLY_REFUNDED
  /// ناموفق
  FAILED
  /// لغو شده
  CANCELLED
}

/// روش پرداخت
enum PaymentMethod {
  /// درگاه زرین‌پال
  ZARINPAL
  /// درگاه نکست‌پی
  NEXTPAY
  /// کیف پول نوبت مارکت
  WALLET
  /// نقدی (حضوری)
  CASH
}

/// نوع تراکنش کیف پول
enum TransactionType {
  /// واریز (شارژ کیف پول)
  DEPOSIT
  /// برداشت (انتقال به حساب بانکی)
  WITHDRAWAL
  /// درآمد از رزرو
  BOOKING_INCOME
  /// کارمزد پلتفرم
  PLATFORM_FEE
  /// بازپرداخت
  REFUND
  /// جایزه معرفی
  REFERRAL_BONUS
}

/// وضعیت پیام
enum MessageStatus {
  /// ارسال شده
  SENT
  /// تحویل شده
  DELIVERED
  /// خوانده شده
  READ
}

/// وضعیت درخواست سفارشی
enum CustomRequestStatus {
  /// جدید
  NEW
  /// در حال بررسی
  UNDER_REVIEW
  /// پیشنهاد ارسال شده
  QUOTE_SENT
  /// تأیید شده
  ACCEPTED
  /// رد شده
  REJECTED
  /// منقضی شده
  EXPIRED
}

/// پلن اشتراک هنرمند
enum ArtistPlan {
  /// رایگان
  FREE
  /// حرفه‌ای
  PRO
  /// استودیو
  STUDIO
}

/// وضعیت آپلود
enum UploadStatus {
  /// آپلود شده
  UPLOADED
  /// پردازش شده
  PROCESSED
  /// خراب
  CORRUPTED
}

/// اندازه تتو
enum TattooSize {
  /// کوچک (زیر ۵ سانتی‌متر)
  SMALL
  /// متوسط (۵ تا ۱۵ سانتی‌متر)
  MEDIUM
  /// بزرگ (۱۵ تا ۳۰ سانتی‌متر)
  LARGE
  /// خیلی بزرگ (بالای ۳۰ سانتی‌متر)
  EXTRA_LARGE
  /// نیم‌آستین
  HALF_SLEEVE
  /// آستین کامل
  FULL_SLEEVE
}

/// وضعیت نوبت‌دهی در دسترسی هنرمند
enum DayOfWeek {
  /// شنبه
  SATURDAY
  /// یکشنبه
  SUNDAY
  /// دوشنبه
  MONDAY
  /// سه‌شنبه
  TUESDAY
  /// چهارشنبه
  WEDNESDAY
  /// پنجشنبه
  THURSDAY
  /// جمعه
  FRIDAY
}

// ============================================================================
// مدل‌ها (Models)
// ============================================================================

/// مدل کاربر - پایه تمامی کاربران سیستم
model User {
  /// شناسه یکتای کاربر
  id String @id @default(cuid())

  /// شماره موبایل (اصلی‌ترین روش احراز هویت در ایران)
  phone String @unique

  /// ایمیل (اختیاری)
  email String? @unique

  /// رمز عبور هش شده
  passwordHash String

  /// نام نمایشی
  displayName String

  /// نام (فارسی)
  firstName String?

  /// نام خانوادگی (فارسی)
  lastName String?

  /// آدرس عکس پروفایل (URL در S3 یا Cloudinary)
  avatarUrl String?

  /// نقش کاربر
  role UserRole

  /// وضعیت حساب
  status UserStatus @default(PENDING_VERIFICATION)

  /// جنسیت
  gender Gender?

  /// تاریخ تولد (میلادی)
  dateOfBirth DateTime?

  /// شهر
  city String?

  /// استان / منطقه
  province String?

  /// آدرس (فقط برای استودیوها)
  address String?

  /// کد پستی
  postalCode String?

  /// بیوگرافی
  bio String?

  /// تصویر کاور
  coverUrl String?

  /// عرض جغرافیایی (نقشه)
  latitude Float?

  /// طول جغرافیایی (نقشه)
  longitude Float?

  /// توکن احراز هویت
  authToken String? @unique

  /// توکن فراموشی رمز عبور
  resetToken String? @unique

  /// انقضا توکن ریست
  resetTokenExpiry DateTime?

  /// توکن فعال‌سازی ایمیل
  emailVerifyToken String? @unique

  /// زبان ترجیحی کاربر
  preferredLanguage String @default("fa")

  /// آیا کاربر اعلان‌های push را فعال کرده
  pushNotificationsEnabled Boolean @default(true)

  /// آیا کاربر اعلان‌های ایمیل را فعال کرده
  emailNotificationsEnabled Boolean @default(true)

  /// آیا کاربر اعلان‌های پیامک را فعال کرده
  smsNotificationsEnabled Boolean @default(true)

  /// آخرین زمان آنلاین بودن
  lastSeenAt DateTime?

  /// تعداد کل رزروها
  totalBookings Int @default(0)

  /// رتبه‌بندی میانگین (از ۱ تا ۵)
  averageRating Float @default(0)

  /// تعداد نظرات دریافت شده
  reviewCount Int @default(0)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با پروفایل هنرمند
  artistProfile ArtistProfile?

  /// رزروهای مشتری (به عنوان مشتری)
  clientBookings Booking[] @relation("ClientBookings")

  /// رزروهای هنرمند (به عنوان هنرمند)
  artistBookings Booking[] @relation("ArtistBookings")

  /// درخواست‌های سفارشی مشتری
  customRequests CustomRequest[]

  /// نظرات ارسال شده
  givenReviews Review[] @relation("GivenReviews")

  /// نظرات دریافت شده
  receivedReviews Review[] @relation("ReceivedReviews")

  /// پیام‌های ارسال شده
  sentMessages Message[]

  /// مکالمات
  conversations ConversationParticipant[]

  /// کیف پول
  wallet Wallet?

  /// تراکنش‌ها
  transactions Transaction[]

  /// پورتفولیوهای ذخیره شده (علاقه‌مندی‌ها)
  savedPortfolios SavedPortfolio[]

  /// لایک‌های پورتفولیو
  portfolioLikes PortfolioLike[]
  flashLikes FlashLike[]

  /// کامنت‌های مجله
  blogComments BlogComment[]
  commentReactions CommentReaction[]

  /// هش‌های رمز عبور قبلی (برای جلوگیری از استفاده مجدد)
  passwordHistory PasswordHistory[]

  /// فالوورهای کاربر
  followers ArtistFollower[]

  /// اعلان‌ها
  notifications Notification[]

  /// اعلان‌های ارسال شده
  sentNotifications Notification[] @relation("NotificationSender")

  /// پاسخ‌های تیکت
  notificationReplies NotificationReply[]

  /// لیست انتظار
  waitlistEntries Waitlist[]

  /// یادداشت‌های هنرمند
  clientNotesReceived ClientNote[]

  /// مقالات
  blogPosts BlogPost[]

  /// گزارش عملیات
  auditLogs AuditLog[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([city])
  @@index([displayName])
  @@map("users")
}

/// سابقه رمز عبور - جلوگیری از استفاده مجدد از رمزهای قبلی
model PasswordHistory {
  /// شناسه یکتای رکورد
  id String @id @default(cuid())

  /// شناسه کاربر
  userId String

  /// هش رمز عبور قبلی
  passwordHash String

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

/// پروفایل هنرمند - اطلاعات تخصصی هنرمندان تتو
model ArtistProfile {
  /// شناسه یکتای پروفایل
  id String @id @default(cuid())

  /// شناسه کاربر مرتبط
  userId String @unique

  /// نام هنری / Stage Name
  artistName String

  /// شناسه یکتای عمومی (برای لینک‌ها، مثال: @sara_ink)
  slug String @unique

  /// بیوگرافی کوتاه (حداکثر ۱۵۰ کاراکتر)
  shortBio String?

  /// بیوگرافی کامل
  fullBio String?

  /// سال شروع فعالیت
  experienceYears Int?

  /// سبک‌های تخصصی
  specializations TattooStyle[]

  /// آیا هنرمند تأیید شده توسط ادمین است
  isVerified Boolean @default(false)

  /// آیا هنرمند در حال پذیرش رزرو است
  isAcceptingBookings Boolean @default(true)

  /// آیا هنرمند سفارش سفارشی می‌پذیرد
  acceptsCustomRequests Boolean @default(true)

  /// حداقل قیمت (تومان)
  minPrice BigInt?

  /// حداکثر قیمت (تومان)
  maxPrice BigInt?

  /// مدت زمان تقریبی هر جلسه (دقیقه)
  averageSessionDuration Int @default(120)

  /// تعداد کل رزروهای تکمیل شده
  completedBookings Int @default(0)

  /// درآمد کل (تومان)
  totalEarnings BigInt @default(0)

  /// تعداد کل فالوورها
  followerCount Int @default(0)

  /// درصد کارمزد پلتفرم
  platformFeePercent Float @default(15.0)

  /// پلن اشتراک
  plan ArtistPlan @default(FREE)

  /// تاریخ انقضای پلن
  planExpiresAt DateTime?

  /// حداکثر نمونه‌کار
  maxPortfolioItems Int @default(20)

  /// حداکثر تتوی فلش
  maxFlashItems Int @default(10)

  /// لینک‌های شبکه اجتماعی
  instagramUrl String?
  telegramUrl String?
  websiteUrl String?

  /// شهر هنرمند
  city String?

  /// نمره رضایت مشتریان (از ۰ تا ۱۰۰)
  satisfactionScore Float @default(0)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// استودیوهای مرتبط
  studioArtists StudioArtist[]

  /// پورتفولیو
  portfolioItems PortfolioItem[]

  /// تتوهای فلش (آماده)
  flashTattoos FlashTattoo[]

  /// جلسات در دسترس
  availabilities Availability[]

  /// فالوورها
  followers ArtistFollower[]

  /// درخواست‌های سفارشی
  customRequests CustomRequest[]

  /// سرویس‌ها
  services Service[]

  /// مرخصی‌ها
  timeOffs TimeOff[]

  /// لیست انتظار
  waitlist Waitlist[]

  /// یادداشت‌های مشتری
  clientNotes ClientNote[]

  @@index([slug])
  @@index([isVerified])
  @@index([isAcceptingBookings])
  @@index([city])
  @@index([experienceYears])
  @@map("artist_profiles")
}

/// فالوور هنرمند - رابطه فالو کردن بین کاربران و هنرمندان
model ArtistFollower {
  /// شناسه یکتای رکورد
  id String @id @default(cuid())

  /// شناسه کاربر فالوور
  userId String

  /// شناسه هنرمند فالو شده
  artistProfileId String

  /// تاریخ فالو کردن
  createdAt DateTime @default(now())

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// رابطه با پروفایل هنرمند
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, artistProfileId])
  @@index([userId])
  @@index([artistProfileId])
  @@map("artist_followers")
}

/// علاقه‌مندی‌های کاربر - پورتفولیوهای ذخیره شده
model SavedPortfolio {
  /// شناسه یکتای رکورد
  id String @id @default(cuid())

  /// شناسه کاربر
  userId String

  /// شناسه آیتم پورتفولیو
  portfolioItemId String

  /// تاریخ ذخیره
  createdAt DateTime @default(now())

  /// رابطه با کاربر
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// رابطه با آیتم پورتفولیو
  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioItemId])
  @@index([userId])
  @@map("saved_portfolios")
}

/// لایک نمونه کار
model PortfolioLike {
  id String @id @default(cuid())
  userId String
  portfolioItemId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  @@unique([userId, portfolioItemId])
  @@index([userId])
  @@index([portfolioItemId])
  @@map("portfolio_likes")
}

model FlashLike {
  id String @id @default(cuid())
  userId String
  flashTattooId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashTattoo FlashTattoo @relation(fields: [flashTattooId], references: [id], onDelete: Cascade)
  @@unique([userId, flashTattooId])
  @@index([userId])
  @@index([flashTattooId])
  @@map("flash_likes")
}

/// استودیوی تتو - مکان فیزیکی
model Studio {
  /// شناسه یکتای استودیو
  id String @id @default(cuid())

  /// نام استودیو
  name String

  /// شناسه عمومی (Slug)
  slug String @unique

  /// توضیحات کوتاه
  description String?

  /// توضیحات کامل
  fullDescription String?

  /// آدرس کامل
  address String

  /// شهر
  city String

  /// استان
  province String

  /// کد پستی
  postalCode String?

  /// شماره تلفن استودیو
  phone String

  /// ایمیل استودیو
  email String?

  /// عرض جغرافیایی
  latitude Float?

  /// طول جغرافیایی
  longitude Float?

  /// تصویر شاخص استودیو
  coverImage String?

  /// لیست عکس‌های استودیو
  images String[]

  /// آیا استودیو فعال است
  isActive Boolean @default(true)

  /// آیا استودیو تأیید شده
  isVerified Boolean @default(false)

  /// ساعت کاری (JSON string)
  workingHours Json?

  /// میانگین رتبه‌بندی
  averageRating Float @default(0)

  /// تعداد نظرات
  reviewCount Int @default(0)

  /// تعداد هنرمندان فعال
  artistCount Int @default(0)

  /// لینک‌های شبکه اجتماعی
  instagramUrl String?
  telegramUrl String?
  websiteUrl String?

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// تاریخ آخرین به‌روزرسانی
  updatedAt DateTime @updatedAt

  /// هنرمندان استودیو
  studioArtists StudioArtist[]

  /// رزروهای استودیو
  bookings Booking[]

  @@index([slug])
  @@index([city])
  @@index([province])
  @@index([isActive])
  @@index([isVerified])
  @@index([averageRating])
  @@index([name])
  @@map("studios")
}

/// رابطه هنرمند-استودیو (M2M)
model StudioArtist {
  /// شناسه یکتای رکورد
  id String @id @default(cuid())

  /// شناسه هنرمند
  artistProfileId String

  /// شناسه استودیو
  studioId String

  /// آیا هنرمند در حال حاضر در این استودیو فعال است
  isActive Boolean @default(true)

  /// تاریخ شروع همکاری
  startDate DateTime?

  /// تاریخ پایان همکاری
  endDate DateTime?

  /// درصد سهم استودیو از درآمد
  studioSharePercent Float @default(30.0)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

  /// رابطه با پروفایل هنرمند
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  /// رابطه با استودیو
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([artistProfileId, studioId])
  @@index([artistProfileId])
  @@index([studioId])
  @@map("studio_artists")
}

/// سرویس‌های ارائه شده توسط هنرمند
model Service {
  /// شناسه یکتای سرویس
  id String @id @default(cuid())

  /// شناسه هنرمند
  artistProfileId String

  /// رابطه با پروفایل هنرمند
  artistProfile ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  /// نام سرویس
  name String

  /// توضیحات سرویس
  description String?

  /// قیمت پایه (تومان)
  basePrice BigInt

  /// حداکثر قیمت (تومان)
  maxPrice BigInt?

  /// مدت زمان تقریبی (دقیقه)
  durationMinutes Int

  /// اندازه‌های پشتیبانی شده
  supportedSizes TattooSize[]

  /// آیا سرویس فعال است
  isActive Boolean @default(true)

  /// تعداد رزروهای این سرویس
  bookingCount Int @default(0)

  /// حداقل ساعت لغو رزرو (پیش‌فرض ۲۴ ساعت)
  cancellationNoticeHours Int @default(24)

  /// نوع بیعانه (FIXED یا PERCENTAGE)
  depositType String @default("PERCENTAGE")

  /// مقدار بیعانه (تومان برای FIXED، درصد برای PERCENTAGE)
  depositValue BigInt @default(30)

  /// تاریخ ایجاد
  createdAt DateTime @default(now())

