{
  "name": "nobat-market",
  "version": "0.1.0",
  "private": true,
  "description": "پلتفرم بازار و رزرو تتو نوبت مارکت",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "worker:stop": "node scripts/stop-preview.mjs",
    "worker:build": "node scripts/stop-preview.mjs && opennextjs-cloudflare build",
    "worker:preview": "node scripts/stop-preview.mjs && opennextjs-cloudflare build && wrangler dev --port 8788",
    "worker:deploy": "node scripts/stop-preview.mjs && opennextjs-cloudflare build && wrangler deploy"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.654.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.21.1",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-jalali": "3.6.0-1",
    "ioredis": "^5.4.1",
    "jalaali-js": "^1.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.447.0",
    "nanoid": "^5.0.7",
    "next": "^14.2.35",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.4.1",
    "sahel-font": "^3.4.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.3",
    "xss": "^1.0.14",
    "zarinpal-checkout": "^1.1.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.15.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.13",
    "tailwindcss-rtl": "^0.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.133.0"
  }
}
