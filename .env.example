# ============================================================================
# متغیرهای محیطی - پلتفرم نوبت مارکت
# ============================================================================
# این فایل الگویی است. فایل .env واقعی را بر اساس این الگو بسازید.
# هرگز فایل .env را در مخزن Git قرار ندهید!
# ============================================================================

# ----------------------------------------------------------------------------
# پایگاه داده PostgreSQL
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://nobat-market:nobat_market_secret@localhost:5432/nobat_market?schema=public"

# ----------------------------------------------------------------------------
# Redis - کش و صف پیام‌ها
# ----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ----------------------------------------------------------------------------
# احراز هویت & JWT
# ----------------------------------------------------------------------------
# کلید مخفی برای امضای JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# مدت اعتبار توکن دسترسی (دقیقه)
JWT_ACCESS_EXPIRY="30"
# مدت اعتبار توکن تازه‌سازی (روز)
JWT_REFRESH_EXPIRY="7"
# کلید مخفی NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-change-this"
# URL پایه اپلیکیشن
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# احراز هویت موبایل (Kavehnegar - کاوه‌نگار)
# ----------------------------------------------------------------------------
KAVEHNEGAR_API_KEY="your-kavehnegar-api-key"
KAVEHNEGAR_SENDER="10008466"
KAVEHNEGAR_VERIFY_TEMPLATE="nobat-market-verify"

# ----------------------------------------------------------------------------
# آپلود فایل - AWS S3
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="nobat-market-uploads"
S3_BUCKET_URL="https://nobat-market-uploads.s3.ap-south-1.amazonaws.com"

# ----------------------------------------------------------------------------
# آپلود فایل - Cloudinary (جایگزین S3)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ----------------------------------------------------------------------------
# درگاه پرداخت - زرین‌پال
# ----------------------------------------------------------------------------
ZARINPAL_MERCHANT_ID="your-zarinpal-merchant-id"
ZARINPAL_SANDBOX="true"
ZARINPAL_CALLBACK_URL="http://localhost:3000/api/payments/callback/zarinpal"

# ----------------------------------------------------------------------------
# درگاه پرداخت - نکست‌پی (جایگزین)
# ----------------------------------------------------------------------------
NEXTPAY_API_KEY="your-nextpay-api-key"
NEXTPAY_ORDER_ID="your-nextpay-order-id"

# ----------------------------------------------------------------------------
# اپلیکیشن
# ----------------------------------------------------------------------------
NODE_ENV="development"
APP_NAME="نوبت مارکت"
APP_URL="http://localhost:3000"
APP_PORT="3000"

# ----------------------------------------------------------------------------
# فایل‌ها و حافظه کش
# ----------------------------------------------------------------------------
UPLOAD_MAX_SIZE="10485760"
FILE_STORAGE_PROVIDER="s3"

# ----------------------------------------------------------------------------
# لاگین و مانیتورینگ
# ----------------------------------------------------------------------------
LOG_LEVEL="debug"

# ----------------------------------------------------------------------------
# Email (اختیاری)
# ----------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="نوبت مارکت <noreply@nobat-market.com>"
